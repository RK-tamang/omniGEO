# Frontend environment variables
#
# BACKEND_URL   Base URL of the Fastify backend (default http://localhost:3001).
#               When set, Next.js /api/* routes proxy to it. When unset the
#               frontend falls back to its local JSON-file store.
# OMNI_BACKEND  Set to "off" to force the local fallback even if BACKEND_URL is set.
# AUTH_SECRET   HMAC secret used to sign the session cookie. Set a strong value
#               in production; changing it invalidates existing sessions.
# AUTH_COOKIE_SECURE  Set to "true" to mark the session cookie Secure (HTTPS only).

BACKEND_URL=http://localhost:3001
OMNI_BACKEND=on
AUTH_SECRET=change-me
AUTH_COOKIE_SECURE=false
