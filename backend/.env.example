# AnswerScope Rust backend configuration.
#
# Copy to `.env` for local use. Docker Compose supplies equivalent values
# directly, so a fresh clone does not require this file to start the API and
# worker. Never commit real secrets.

# --- Runtime ----------------------------------------------------------------
# development | test | staging | production (default: development)
APP_ENV=development
# 0.0.0.0:8080 (default)
API_BIND_ADDR=0.0.0.0:8080
# json | pretty (default: json)
LOG_FORMAT=json
# Default: answerscope_api=info,answerscope_worker=info,tower_http=info
RUST_LOG=answerscope_api=info,answerscope_worker=info,tower_http=info

# --- Database ---------------------------------------------------------------
# Required. Must be a postgres:// or postgresql:// URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/omnigeo
# 1..100 (default: 10)
DATABASE_MAX_CONNECTIONS=10
# 1..300 seconds (default: 10)
DB_CONNECT_TIMEOUT_SECS=10
# 1..60 seconds (default: 5)
DB_ACQUIRE_TIMEOUT_SECS=5
# 100..30000 milliseconds (default: 2000)
READINESS_TIMEOUT_MS=2000

# --- Lifecycle --------------------------------------------------------------
# 1..300 seconds (default: 30)
SHUTDOWN_TIMEOUT_SECS=30

# --- Crawler ----------------------------------------------------------------
CRAWL_PAGE_LIMIT=50
CRAWL_MAX_DEPTH=4
CRAWL_RESPONSE_BYTE_LIMIT=2000000
CRAWL_MIN_REQUEST_INTERVAL_MS=500
CRAWL_REQUEST_TIMEOUT_SECS=15
CRAWL_MAX_REDIRECTS=5
CRAWL_CACHE_TTL_SECS=300

# --- Optional integrations --------------------------------------------------
# Optional: recommended for automated PageSpeed usage and quota attribution.
PAGESPEED_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
REPORT_STORAGE_DIR=./var/reports
REPORT_ANONYMOUS_MONTHLY_LIMIT=10
BILLING_MANUAL_SETTLEMENT_SECRET=
BILLING_MANUAL_PAYMENT_INSTRUCTIONS=Contact AnswerScope billing support for verified payment instructions.
BILLING_INVOICE_DUE_DAYS=14
# Authentication: use HTTPS and AUTH_COOKIE_SECURE=true in production.
APP_BASE_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
AUTH_COOKIE_SECURE=false
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_REDIRECT_URI=http://localhost:3000/auth/workos/callback
# Durable email outbox. Messages stay queued until a supported provider is configured.
RESEND_API_KEY=
EMAIL_FROM=AnswerScope <no-reply@answerscope.example>
# Premium provider execution is disabled until credentials and the conservative
# per-request reservation estimate are configured from your current provider plan.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_ESTIMATED_COST_MICRO_USD=
# Optional DataForSEO throttling and budget controls.
DATAFORSEO_MAX_CONCURRENT_REQUESTS=4
DATAFORSEO_MAX_BATCH_TASKS=20
DATAFORSEO_REQUEST_TIMEOUT_SECONDS=130
DATAFORSEO_MONTHLY_BUDGET_USD=100
DATAFORSEO_DAILY_BUDGET_USD=10
DATAFORSEO_CACHE_TTL_SECONDS=86400

# --- AI Visibility Providers ---
# OpenAI Responses API (model_response + web_search grounding)
OPENAI_API_KEY=
OPENAI_VISIBILITY_MODEL=gpt-4o-mini
OPENAI_ESTIMATED_COST_MICRO_USD=500

# Gemini API (Google Search grounding)
GEMINI_API_KEY=
GEMINI_VISIBILITY_MODEL=gemini-1.5-pro
GEMINI_ESTIMATED_COST_MICRO_USD=500

# Perplexity API
PERPLEXITY_API_KEY=
PERPLEXITY_VISIBILITY_MODEL=sonar
PERPLEXITY_ESTIMATED_COST_MICRO_USD=500

# SerpApi (Google AI Overview observations)
SERPAPI_API_KEY=
SERPAPI_ESTIMATED_COST_MICRO_USD=500
